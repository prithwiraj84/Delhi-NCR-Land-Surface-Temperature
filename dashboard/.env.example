# Public address of the deployed site (canonical links, sitemap, social previews).
# On Vercel it defaults to the production domain (VERCEL_PROJECT_PRODUCTION_URL); set it once
# you attach a custom domain, with or without https:// (e.g. ncr-heat-atlas.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Sub-path the site is served under (leave empty on Vercel).
NEXT_PUBLIC_BASE_PATH=

# Base URL of the web bundle exported by the notebook (outputs/web/*).
# Leave empty to use "<base path>/data", i.e. the files in dashboard/public/data/.
# A bundle hosted elsewhere must allow CORS, e.g. https://example.org/ncr-lst/web
NEXT_PUBLIC_DATA_BASE_URL=
